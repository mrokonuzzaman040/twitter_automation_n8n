# =============================================================================
# Social Agents - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values.
# Run ./setup.sh to generate random values for MASTER_KEY, ADMIN_PASSWORD, and API_TOKEN.
# =============================================================================

# -----------------------------------------------------------------------------
# Security Keys (Generated by setup.sh - DO NOT CHANGE these after setup)
# -----------------------------------------------------------------------------
# Random 64 hex chars - Encrypts all stored API keys and credentials
# Must be 16+ characters. BACK THIS UP. If lost, saved secrets cannot be decrypted.
MASTER_KEY=your_master_key_here

# Random password for the admin panel login
ADMIN_PASSWORD=your_admin_password_here

# Random token for API access (used by n8n and external scripts)
# Set to empty to disable API token access
API_TOKEN=your_api_token_here

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
# Host port for the admin panel (bound to 127.0.0.1 only)
PANEL_PORT=8080

# Host port for n8n (bound to 127.0.0.1 only)
N8N_PORT=5678

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# NVIDIA API key from https://build.nvidia.com
# or API key for another supported provider (OpenAI, Anthropic, etc.)
LLM_API_KEY=your_nvidia_api_key_here

# Optional: Override the default provider
# Supported: nvidia, openai, anthropic, deepseek, xai, groq, openrouter
LLM_PROVIDER=nvidia

# Optional: Override the default model
# Leave empty to use provider's default model
LLM_MODEL=

# Optional: Override the base URL
# Leave empty to use provider's default base URL
LLM_BASE_URL=

# Maximum parallel AI requests across all agents
# Lower this if you hit rate limits
LLM_CONCURRENCY=3

# -----------------------------------------------------------------------------
# Google Sheets Configuration (Optional)
# -----------------------------------------------------------------------------
# Master accounts sheet URL or ID
# Leave empty to add accounts manually in the panel
MASTER_SHEET_ID=

# Content schedule sheet URL or ID
# Leave empty to use a separate sheet per account
SCHEDULE_SHEET_ID=

# Sync master sheet every X minutes
SHEET_SYNC_MINUTES=5

# Automatically start agents for new accounts from the sheet
# 1 = yes, 0 = no
AUTO_START_NEW=1

# -----------------------------------------------------------------------------
# Telegram Configuration (Optional but Recommended)
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
# Leave empty to disable Telegram messages
TELEGRAM_BOT_TOKEN=

# The chat ID that receives drafts and can approve them
# Only button presses from this chat are accepted
# In a group, every member can approve
TELEGRAM_CHAT_ID=

# Optional: Custom Telegram API URL (for proxy)
# Leave empty to use default https://api.telegram.org
TELEGRAM_API_URL=

# -----------------------------------------------------------------------------
# Instagram Configuration
# -----------------------------------------------------------------------------
# Facebook Graph API version for Instagram
# Update when Meta retires the current version
GRAPH_API_VERSION=v23.0

# -----------------------------------------------------------------------------
# Timezone Configuration
# -----------------------------------------------------------------------------
# Timezone for n8n schedule triggers
# Example: Asia/Dhaka, America/New_York, UTC
TZ=UTC

# -----------------------------------------------------------------------------
# Update Configuration
# -----------------------------------------------------------------------------
# GitHub repository in owner/name format for update checks
# Example: mrokonuzzaman040/twitter_automation_n8n
GITHUB_REPO=

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------
# Webhook URL where events are sent to n8n
# Default: http://n8n:5678/webhook/social-agents
N8N_WEBHOOK_URL=http://n8n:5678/webhook/social-agents

# Send events to n8n
# 1 = yes, 0 = no
N8N_EVENTS=1
