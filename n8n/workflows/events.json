{
  "id": "SocialAgentsEvnt",
  "name": "Social Agents - Events to Telegram",
  "active": true,
  "nodes": [
    {
      "id": "n1",
      "name": "Event from Social Agents",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "social-agents",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "social-agents-events"
    },
    {
      "id": "tgcfg1",
      "name": "Get Telegram config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SOCIAL_AGENTS_URL }}/api/settings/telegram",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SOCIAL_AGENTS_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "n2",
      "name": "Build message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "event",
              "value": "={{ $json.body.event }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "message",
              "value": "={{ (() => { const b = $json.body || {}; const d = b.data || {}; const a = b.account ? '@' + b.account.handle + ' (' + b.account.platform + ')' : 'Social Agents'; if (b.event === 'drafts_ready') return '📝 ' + a + ': ' + d.posts.length + ' new drafts are waiting for your approval'; if (b.event === 'post_published') return '✅ ' + a + ': published ' + d.url; if (b.event === 'post_failed') return '⚠️ ' + a + ': post #' + d.id + ' failed - ' + d.error; if (b.event === 'cycle_failed') return '⚠️ ' + a + ': research and content cycle failed - ' + d.error; return 'ℹ️ ' + a + ': ' + (d.message || b.event); })() }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "account",
              "value": "={{ $json.body.account }}",
              "type": "object"
            },
            {
              "id": "a4",
              "name": "data",
              "value": "={{ $json.body.data }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Telegram set up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Get Telegram config').item.json.bot_token && $('Get Telegram config').item.json.chat_id ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Are these new drafts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Build message').item.json.event }}",
              "rightValue": "drafts_ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "One item per draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "jsCode": "// one Telegram message per draft - read the original event from Build message by name,\n// since this node's own input is Get Telegram config's response, not Build message's.\nconst out = [];\nfor (const post of $('Build message').item.json.data.posts || []) {\n  out.push({ json: { account: $('Build message').item.json.account, post } });\n}\nreturn out;"
      }
    },
    {
      "id": "n6",
      "name": "Telegram: draft with approve buttons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Get Telegram config').item.json.api_url }}/bot{{ $('Get Telegram config').item.json.bot_token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Get Telegram config').item.json.chat_id, text: '📝 Draft for @' + $json.account.handle + ' (' + $json.account.platform + ')\\n\\n' + $json.post.text + ($json.post.hashtags ? '\\n\\n' + $json.post.hashtags : '') + '\\n\\n🕒 Planned: ' + $json.post.scheduled_local + ($json.post.image_url ? '\\n🖼 ' + $json.post.image_url : ''), reply_markup: { inline_keyboard: [[{ text: '✅ Approve', callback_data: 'approve:' + $json.account.id + ':' + $json.post.id }, { text: '🚀 Approve + post now', callback_data: 'post_now:' + $json.account.id + ':' + $json.post.id }], [{ text: '📝 Keep as draft', callback_data: 'draft:' + $json.account.id + ':' + $json.post.id }]] } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "n7",
      "name": "Telegram: notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Get Telegram config').item.json.api_url }}/bot{{ $('Get Telegram config').item.json.bot_token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Get Telegram config').item.json.chat_id, text: $('Build message').item.json.message }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "n8",
      "name": "Telegram not set up - nothing sent",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        460
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Event from Social Agents": {
      "main": [
        [
          {
            "node": "Build message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build message": {
      "main": [
        [
          {
            "node": "Get Telegram config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram set up?": {
      "main": [
        [
          {
            "node": "Are these new drafts?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram not set up - nothing sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Are these new drafts?": {
      "main": [
        [
          {
            "node": "One item per draft",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram: notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per draft": {
      "main": [
        [
          {
            "node": "Telegram: draft with approve buttons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Telegram config": {
      "main": [
        [
          {
            "node": "Telegram set up?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}